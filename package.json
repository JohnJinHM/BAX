{
  "name": "bax",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:ui": "node --test tests/*.test.mjs",
    "bindings": "cargo test -q -p bax-core -p bax-batrace -p bax-store -p bax-engine --features bax-core/ts,bax-batrace/ts,bax-store/ts,bax-engine/ts export_bindings",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tauri-apps/api": "2.11.1",
    "echarts": "6.1.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vue-tsc": "3.3.14"
  }
}
